# Direct Postgres connection used by the backend (Supabase local: port 54322)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres

# Supabase project (local: `npx supabase status` shows these values)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=

# Public URL of this app (used for the OAuth redirect)
APP_BASE_URL=http://localhost:8000

# Comma-separated e-mails that become admins on first login
ADMIN_EMAILS=

# Time zone that defines the "day" for the one-guess-per-day rule
TIMEZONE=America/Sao_Paulo

# Set to true in production (HTTPS) so session cookies get the Secure flag
SECURE_COOKIES=false
